{
  "name": "smart_lock_formal_verification",
  "description": "Mo hinh khoa thong minh co xac thuc PIN, bo dem ba lan sai, trang thai ALARM va hanh vi tan cong tiep tuc sau ALARM.",
  "requirements": [
    {
      "id": "REQ-1",
      "text": "Khoa chi duoc chuyen sang UNLOCKED sau khi PIN duoc xac thuc dung",
      "category": "safety",
      "priority": "HIGH"
    },
    {
      "id": "REQ-2",
      "text": "Sau lan nhap PIN sai thu ba, he thong phai chuyen sang ALARM",
      "category": "safety",
      "priority": "HIGH"
    },
    {
      "id": "REQ-3",
      "text": "Moi hanh dong khong phai ADMIN_RESET tai ALARM phai giu nguyen ALARM",
      "category": "safety",
      "priority": "HIGH"
    },
    {
      "id": "REQ-4",
      "text": "ADMIN_RESET la hanh dong duy nhat dua ALARM ve LOCKED va dat bo dem ve 0",
      "category": "functional",
      "priority": "HIGH"
    },
    {
      "id": "REQ-5",
      "text": "Phai ton tai duong thi hanh hop le den UNLOCKED bang PIN dung",
      "category": "liveness",
      "priority": "MEDIUM"
    },
    {
      "id": "REQ-6",
      "text": "LOCK_DOOR tu UNLOCKED phai dua he thong ve LOCKED",
      "category": "functional",
      "priority": "HIGH"
    },
    {
      "id": "REQ-7",
      "text": "CANCEL khi dang nhap PIN phai xoa PIN tam va dua he thong ve LOCKED",
      "category": "functional",
      "priority": "MEDIUM"
    },
    {
      "id": "REQ-8",
      "text": "Mau kiem thu vung dem PIN phai phat hien ghi vuot bien",
      "category": "memory",
      "priority": "HIGH"
    },
    {
      "id": "REQ-9",
      "text": "Mau ban ghi xac thuc phai phat hien bo nho cap phat khong duoc giai phong",
      "category": "memory",
      "priority": "HIGH"
    },
    {
      "id": "REQ-10",
      "text": "Mau phien mo khoa phai phat hien giai phong bo nho hai lan",
      "category": "memory",
      "priority": "HIGH"
    },
    {
      "id": "REQ-11",
      "text": "Mau bo dem PIN phai phat hien truy cap sau khi giai phong",
      "category": "memory",
      "priority": "HIGH"
    },
    {
      "id": "REQ-12",
      "text": "Cac phep cong bo dem phai duoc kiem tra nguy co tran so nguyen 32 bit",
      "category": "safety",
      "priority": "HIGH"
    }
  ],
  "state_machine": {
    "states": [
      "LOCKED_0",
      "UNLOCKING_0",
      "LOCKED_1",
      "UNLOCKING_1",
      "LOCKED_2",
      "UNLOCKING_2",
      "UNLOCKED_AUTH",
      "ALARM_3"
    ],
    "initial": [
      "LOCKED_0"
    ],
    "labeling": {
      "LOCKED_0": [
        "locked",
        "failed_0"
      ],
      "UNLOCKING_0": [
        "locked",
        "unlocking",
        "failed_0"
      ],
      "LOCKED_1": [
        "locked",
        "failed_1"
      ],
      "UNLOCKING_1": [
        "locked",
        "unlocking",
        "failed_1"
      ],
      "LOCKED_2": [
        "locked",
        "failed_2"
      ],
      "UNLOCKING_2": [
        "locked",
        "unlocking",
        "failed_2"
      ],
      "UNLOCKED_AUTH": [
        "unlocked",
        "authenticated"
      ],
      "ALARM_3": [
        "locked",
        "alarm",
        "failed_3"
      ]
    },
    "transitions": [
      [
        "LOCKED_0",
        "UNLOCKING_0"
      ],
      [
        "UNLOCKING_0",
        "UNLOCKED_AUTH"
      ],
      [
        "UNLOCKING_0",
        "LOCKED_1"
      ],
      [
        "LOCKED_1",
        "UNLOCKING_1"
      ],
      [
        "UNLOCKING_1",
        "UNLOCKED_AUTH"
      ],
      [
        "UNLOCKING_1",
        "LOCKED_2"
      ],
      [
        "LOCKED_2",
        "UNLOCKING_2"
      ],
      [
        "UNLOCKING_2",
        "UNLOCKED_AUTH"
      ],
      [
        "UNLOCKING_2",
        "ALARM_3"
      ],
      [
        "UNLOCKED_AUTH",
        "LOCKED_0"
      ],
      [
        "ALARM_3",
        "ALARM_3"
      ],
      [
        "ALARM_3",
        "LOCKED_0"
      ]
    ]
  },
  "additional_flows": {
    "Mo hinh loi v0": {
      "states": [
        "LOCKED",
        "UNLOCKING",
        "UNLOCKED_UNAUTH"
      ],
      "initial": [
        "LOCKED"
      ],
      "labeling": {
        "LOCKED": [
          "locked"
        ],
        "UNLOCKING": [
          "locked",
          "unlocking"
        ],
        "UNLOCKED_UNAUTH": [
          "unlocked",
          "unauthenticated",
          "violation"
        ]
      },
      "transitions": [
        [
          "LOCKED",
          "UNLOCKING"
        ],
        [
          "UNLOCKING",
          "UNLOCKED_UNAUTH"
        ],
        [
          "UNLOCKED_UNAUTH",
          "LOCKED"
        ]
      ]
    }
  },
  "safety_properties": [
    "AG(!violation)",
    "EF(authenticated)",
    "EF(alarm)"
  ],
  "mutual_exclusion": {
    "atom1": "unlocked",
    "atom2": "alarm"
  },
  "functions": [
    {
      "name": "parse_pin_input",
      "kind": "buffer_copy",
      "expected_cwe": "CWE-120"
    },
    {
      "name": "write_auth_log",
      "kind": "alloc_release",
      "expected_cwe": "CWE-401"
    },
    {
      "name": "close_unlock_session",
      "kind": "alloc_release",
      "expected_cwe": "CWE-415"
    },
    {
      "name": "release_pin_buffer",
      "kind": "alloc_release",
      "expected_cwe": "CWE-416"
    }
  ],
  "arithmetic_checks": [
    "failed_attempt_counter",
    "pin_digit_counter",
    "auth_log_counter",
    "unlock_event_counter",
    "admin_reset_counter"
  ],
  "test_cases": [
    {
      "id": "TC-P1-BUGGY",
      "requirement_ids": [
        "REQ-1"
      ],
      "title": "PIN sai mo khoa tren v0",
      "preconditions": "Khoa o LOCKED, failed_attempts = 0",
      "steps": [
        "Nhap PIN sai",
        "Gui SUBMIT_PIN"
      ],
      "expected_result": "BMC tim thay UNLOCKED voi authenticated = false tren v0",
      "priority": "HIGH"
    },
    {
      "id": "TC-ALARM-PERSIST",
      "requirement_ids": [
        "REQ-2",
        "REQ-3"
      ],
      "title": "Tan cong tiep tuc sau ALARM",
      "preconditions": "Khoa o LOCKED, failed_attempts = 0",
      "steps": [
        "Nhap sai PIN ba lan",
        "Tiep tuc PRESS_DIGIT va SUBMIT_PIN khi da ALARM"
      ],
      "expected_result": "He thong van o ALARM, failed_attempts = 3",
      "priority": "HIGH"
    },
    {
      "id": "TC-ADMIN-RESET",
      "requirement_ids": [
        "REQ-4"
      ],
      "title": "Khoi phuc boi quan tri vien",
      "preconditions": "He thong dang o ALARM",
      "steps": [
        "Gui ADMIN_RESET"
      ],
      "expected_result": "He thong ve LOCKED va failed_attempts = 0",
      "priority": "HIGH"
    },
    {
      "id": "TC-P3-VALID",
      "requirement_ids": [
        "REQ-5"
      ],
      "title": "Mo khoa hop le",
      "preconditions": "Khoa o LOCKED",
      "steps": [
        "Nhap PIN dung",
        "Gui SUBMIT_PIN"
      ],
      "expected_result": "He thong den UNLOCKED_AUTH",
      "priority": "MEDIUM"
    },
    {
      "id": "TC-LOCK-DOOR",
      "requirement_ids": [
        "REQ-6"
      ],
      "title": "Khoa cua sau khi mo",
      "preconditions": "He thong o UNLOCKED_AUTH",
      "steps": [
        "Gui LOCK_DOOR"
      ],
      "expected_result": "He thong ve LOCKED",
      "priority": "HIGH"
    },
    {
      "id": "TC-CANCEL",
      "requirement_ids": [
        "REQ-7"
      ],
      "title": "Huy qua trinh nhap PIN",
      "preconditions": "He thong o UNLOCKING",
      "steps": [
        "Gui CANCEL"
      ],
      "expected_result": "PIN tam duoc xoa va he thong ve LOCKED",
      "priority": "MEDIUM"
    },
    {
      "id": "TC-MEMORY-CWE",
      "requirement_ids": [
        "REQ-8",
        "REQ-9",
        "REQ-10",
        "REQ-11"
      ],
      "title": "Quet bon mau loi bo nho",
      "preconditions": "Bien dich smart_lock_cwe_samples.c voi Clang va AddressSanitizer",
      "steps": [
        "Chay static analyzer",
        "Chay tung nhanh overflow, double-free va use-after-free"
      ],
      "expected_result": "Phat hien CWE-120, CWE-401, CWE-415 va CWE-416 trong bo mau co chu dich",
      "priority": "HIGH"
    },
    {
      "id": "TC-SMT-COUNTERS",
      "requirement_ids": [
        "REQ-12"
      ],
      "title": "Tim nghiem tran bo dem 32 bit",
      "preconditions": "Z3 san sang",
      "steps": [
        "Chay smart_lock_extended_smt.py"
      ],
      "expected_result": "Nam cau hinh tong quat SAT; bo dem failed_attempts bi chan 0..3 cho ket qua UNSAT",
      "priority": "HIGH"
    }
  ]
}
